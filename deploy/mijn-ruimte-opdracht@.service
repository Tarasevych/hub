# Methode 3 (gepantserde opdracht, root): één werkwoord uit een vaste lijst (status, releases, backup, uitrol-nu, terugdraaien).
# De app start dit met `systemctl start mijn-ruimte-opdracht@<werkwoord>.service`; de polkit-regel
# /etc/polkit-1/rules.d/50-mijn-ruimte-opdracht.rules staat dat alleen toe voor gebruiker mijnruimte en precies die vijf namen.
# Het script controleert het werkwoord nogmaals en leest geen enkel bestand dat de app kan schrijven.
[Unit]
Description=Mijn Ruimte: beheeropdracht %i (vaste lijst)
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/mijn-ruimte-opdracht %i
StandardInput=null
PrivateTmp=yes
ProtectHome=yes
TimeoutStartSec=15min
# SEC-002 (server-uitrol-11): de app zelf start deze unit (polkit). Vier van de vijf werkwoorden lezen alleen en schrijven een
# uitslag in /var/lib; ze hoeven /usr, /boot en /etc (schakelaars in /etc/mijn-ruimte, sudoers, sshd) nooit te kunnen wijzigen.
# ProtectSystem=full maakt die drie alleen-lezen; /var, /srv en /run blijven schrijfbaar (uitslag, stempel, symlink «current»,
# slot van de installer). Eén uitzondering voor «terugdraaien»: de installer zet zo nodig de unit van de MCP-deur terug
# (/etc/systemd/system/mijn-ruimte-mcp.service, mcp_deur_bijwerken in deploy/installeer-app.sh).
# NoNewPrivileges: zoals mijn-ruimte-besluit.service, die hetzelfde terugdraaien uitvoert.
NoNewPrivileges=yes
ProtectSystem=full
ReadWritePaths=-/etc/systemd/system
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
