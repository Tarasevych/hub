# /etc/systemd/system/mijn-ruimte-mail-onderhoud.timer — Mijn Ruimte: mailprovider-onderhoud (cron.json mail-provider-maintenance, elke 5 min)
[Unit]
Description=Mijn Ruimte: mailprovider-onderhoud (cron.json mail-provider-maintenance, elke 5 min)

[Timer]
OnCalendar=*:0/5
RandomizedDelaySec=20s
Persistent=true
AccuracySec=30s
Unit=mijn-ruimte-cron@mail-provider-maintenance.service

[Install]
WantedBy=timers.target
