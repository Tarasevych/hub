# /etc/systemd/system/mijn-ruimte-opruimen.timer — Mijn Ruimte: opruimen van verlopen OAuth-states, transacties, sessies en limietrijen (elk uur)
[Unit]
Description=Mijn Ruimte: opruimen van verlopen OAuth-states, transacties, sessies en limietrijen (elk uur)

[Timer]
OnCalendar=*:17
RandomizedDelaySec=60s
Persistent=true
AccuracySec=30s
Unit=mijn-ruimte-cron@opruimen.service

[Install]
WantedBy=timers.target
