# /etc/systemd/system/mijn-ruimte-backup.service — maakt een back-up (pg_dump + uploads-tar) in
# /srv/backups/mijn-ruimte/<datum>/ die de host daarna ophaalt (pull). Zie backup-maken.sh.
[Unit]
Description=Mijn Ruimte back-up (database + uploads) voor ophalen door de host
After=postgresql.service

[Service]
Type=oneshot
User=mijnruimte
Group=mijnruimte-backup
SupplementaryGroups=mijnruimte
EnvironmentFile=/etc/mijn-ruimte/geheimen.env
Environment=UPLOADS_DIR=/srv/data/uploads
Environment=BACKUP_DIR=/srv/backups/mijn-ruimte
ExecStart=/srv/mijn-ruimte/current/deploy/backup-maken.sh
TimeoutStartSec=2h
UMask=0027
Nice=10
IOSchedulingClass=idle

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/srv/backups/mijn-ruimte
ReadOnlyPaths=/srv/data/uploads
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallArchitectures=native
