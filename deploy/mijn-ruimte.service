# /etc/systemd/system/mijn-ruimte.service — HTTP-server van Mijn Ruimte (zelf gehost).
# Luistert alleen op 127.0.0.1:8080; publiek verkeer komt uitsluitend via cloudflared (zie cloudflared-config.yml).
# Geheimen: /etc/mijn-ruimte/geheimen.env (0600 root:root; systemd leest hem als root), zie ENV-VARS.md.
[Unit]
Description=Mijn Ruimte (zelf-gehoste app)
Documentation=file:///srv/mijn-ruimte/current/deploy/LEESMIJ.md
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=mijnruimte
Group=mijnruimte
# Audit-fix 4: alleen de runtime-omgeving. migratie.env (DATABASE_URL legacy + DATABASE_URL_MIGRATIE) wordt hier
# bewust NIET geladen; alleen de migratiestap van installeer-app.sh leest die.
EnvironmentFile=/etc/mijn-ruimte/geheimen.env
# Etap E: journaal naar uw eigen SIEM. Alleen SIEM_-regels; bestaat niet = export uit (installeer-app.sh siem aan|uit, deploy/SIEM.md).
EnvironmentFile=-/etc/mijn-ruimte/siem.env
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8080
Environment=UPLOADS_DIR=/srv/data/uploads
Environment=DASHBOARD_DIR=/srv/mijn-ruimte/dashboard
WorkingDirectory=/srv/mijn-ruimte/current
ExecStart=/usr/bin/node /srv/mijn-ruimte/current/dist-server/start.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
LimitNOFILE=65536
UMask=0027

# --- Hardening ---
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/srv/data/uploads
# Goedkeuren met een passkey: de app legt hier een goedgekeurd pakket of een sleutelverzoek neer; root controleert alles zelf
# (deploy/RUNBOOK-VEILIGE-UITROL.md §13). "-" = geen fout als de map (nog) niet bestaat.
ReadWritePaths=-/srv/mijn-ruimte/goedkeur-inbox
# SSH-certificaat: de app legt hier alleen het verzoek (publieke sleutel). Root tekent in een eigen map.
ReadWritePaths=-/srv/mijn-ruimte/ssh-ca-inbox
# Besluiten van de eigenaar (passkey, §15): de app legt hier besluit-<id>.json neer en tikt `aanvraag` aan; root (mijn-ruimte-besluit.path)
# haalt het op. ONTBRAK tot 29.10.2026: door ProtectSystem=strict was /srv voor de app alleen-lezen → het schrijven mislukte met EROFS,
# de inbox bleef leeg, .service startte nooit (bewijs van de eigenaar bij een terugdraaipoging).
ReadWritePaths=-/srv/mijn-ruimte/besluit-inbox
# Blijvende archieven van releases (audit 18.10.2026, punt 4): root schrijft (0640), de app leest voor «Завантажити цей випуск» en ruimt
# op «Видалити старіші» (passkey) op. Map root:mijnruimte 0770; de app kan er niets in laten uitvoeren (alleen tar.gz + .sha256).
ReadWritePaths=-/srv/mijn-ruimte/pakketten
# Eigen logo's van de beheerder (21.10.2026): officiële SVG/PNG ≤ 200 KB; de app leest altijd en schrijft alleen na passkey (admin → Інтеграції).
ReadWritePaths=-/srv/mijn-ruimte/merk-eigen
# ORCH-001 (31.10.2026, RUNBOOK §18.1): uploads van agenten/eigenaar in orch-inbox (fragmenten ≤ 300 MiB) en de git-werkkopie orch-repo
# (takken inlevering/* en regels/*, records, wachtrij — integratie zelf wordt nooit omgeschakeld). Ontbrak in de eerste versie van etap 3:
# door ProtectSystem=strict faalde de eerste upload met EROFS (adversariële review 31.10.2026). "-" = geen fout zolang §18.1 niet gedaan is.
ReadWritePaths=-/srv/mijn-ruimte/orch-inbox
ReadWritePaths=-/srv/mijn-ruimte/orch-repo
# Etap E: NDJSON-export van het journaal (alleen als siem.env SIEM_BESTAND zet). "-" = geen fout zonder de map.
ReadWritePaths=-/var/log/mijn-ruimte
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
# Alleen IPv4/IPv6 (Postgres via 127.0.0.1, Google/Microsoft uitgaand) en Unix-sockets.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
# MemoryDenyWriteExecute=yes kan NIET: de V8-JIT van Node heeft schrijf+uitvoer-geheugen nodig.
MemoryDenyWriteExecute=no

[Install]
WantedBy=multi-user.target
