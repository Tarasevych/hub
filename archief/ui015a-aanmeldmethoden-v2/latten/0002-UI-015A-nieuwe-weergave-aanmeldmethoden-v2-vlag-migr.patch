+++ b/src/aanmeldmethoden-v2/aanmeldmethoden-v2.css
@@ -0,0 +1,182 @@
+/* UI-015 (vlag aanmeldmethoden-v2): nieuwe pagina «Способи входу». Alles onder .amv2; thema via de echte klassen op <html>
+   (theme-light/theme-dark/theme-plum-*, gezet door de globale thema-store; «авто» kiest de store zelf). Merklogo's staan op een
+   witte tegel en worden NIET getint. Indeling volgt de BREEDTE VAN DE CONTAINER (container queries), niet die van het scherm. */
+.amv2{--a-bg:#EDF2FA;--a-vl:#FFFFFF;--a-tk:#18243D;--a-zw:#71809D;--a-ac:#2458C8;--a-ac-tk:#fff;--a-lijn:#E5EBF5;--a-goed:#16866D;--a-goed-bg:#E3F4EE;--a-let:#AA7219;--a-let-bg:#FBF1DE;--a-info:#2458C8;--a-info-bg:#E6EEFC;--a-stil-bg:#EEF1F6;--a-schaduw:0 1px 2px rgba(24,36,61,.05),0 8px 24px rgba(24,36,61,.06);--a-r:20px;
+  container-type:inline-size;container-name:amv2;display:flex;flex-direction:column;gap:18px;color:var(--a-tk);min-width:0;max-width:1220px;margin:0 auto;width:100%}
+html.theme-dark .amv2,html.theme-plum-dark .amv2{--a-bg:#0E1625;--a-vl:#1C2638;--a-tk:#ECF2FF;--a-zw:#A1AFC8;--a-ac:#93B9FF;--a-ac-tk:#0E1625;--a-lijn:#34425A;--a-goed:#91D9BD;--a-goed-bg:rgba(145,217,189,.13);--a-let:#FFCF76;--a-let-bg:rgba(255,207,118,.13);--a-info:#93B9FF;--a-info-bg:rgba(147,185,255,.14);--a-stil-bg:rgba(161,175,200,.12);--a-schaduw:0 1px 2px rgba(0,0,0,.3),0 10px 28px rgba(0,0,0,.28)}
+.amv2 *{box-sizing:border-box}
+.amv2 svg{flex:none}
+
+/* Hero */
+.amv2-hero{position:relative;overflow:hidden;border-radius:24px;min-height:220px;display:flex;align-items:center;isolation:isolate;background:#143b70}
+.amv2-hero-beeld{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:70% 50%;z-index:-1;user-select:none}
+.amv2-hero::after{content:'';position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(10,26,56,.72) 0%,rgba(10,26,56,.35) 55%,rgba(10,26,56,0) 80%)}
+.amv2-hero-tekst{padding:28px clamp(18px,4cqw,44px);max-width:560px;color:#fff}
+.amv2-hero h2{margin:0 0 6px;font-size:clamp(22px,3.4cqw,32px);line-height:1.15;font-weight:700;letter-spacing:-.01em;color:#fff}
+.amv2-hero p{margin:0 0 18px;font-size:15px;line-height:1.45;color:rgba(255,255,255,.88)}
+.amv2-hero-knop{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:0 20px;border-radius:999px;border:0;background:#fff;color:#18243D;font-weight:600;font-size:14px;cursor:pointer;box-shadow:0 6px 18px rgba(0,0,0,.18)}
+.amv2-hero-knop svg{width:18px;height:18px}
+.amv2-hero-knop:disabled{opacity:.6;cursor:default}
+
+/* Filter */
+.amv2-filter{display:flex;gap:10px;align-items:center;flex-wrap:wrap;background:var(--a-vl);border:1px solid var(--a-lijn);border-radius:var(--a-r);padding:8px;box-shadow:var(--a-schaduw)}
+.amv2-chips{display:flex;gap:6px;overflow-x:auto;scrollbar-width:none;flex:1 1 auto;min-width:0;padding:2px}
+.amv2-chips::-webkit-scrollbar{display:none}
+.amv2-chip{flex:none;min-height:40px;padding:0 16px;border-radius:999px;border:1px solid transparent;background:transparent;color:var(--a-zw);font-size:14px;font-weight:500;cursor:pointer;white-space:nowrap}
+.amv2-chip:hover{background:var(--a-stil-bg);color:var(--a-tk)}
+.amv2-chip.actief{background:var(--a-ac);color:var(--a-ac-tk)}
+.amv2-zoek{display:flex;align-items:center;gap:6px;flex:0 1 240px;min-width:160px;min-height:40px;padding:0 6px 0 12px;border-radius:999px;background:var(--a-stil-bg);color:var(--a-zw)}
+.amv2-zoek svg{width:16px;height:16px}
+.amv2-zoek input{flex:1;min-width:0;border:0;background:transparent;color:var(--a-tk);font:inherit;font-size:14px;outline:none;min-height:40px}
+.amv2-zoek input::-webkit-search-cancel-button{display:none}
+.amv2-zoek-wis{display:grid;place-items:center;width:32px;height:32px;border:0;border-radius:50%;background:transparent;color:var(--a-zw);cursor:pointer}
+
+/* Groepen */
+.amv2-groep{display:flex;flex-direction:column;gap:12px}
+.amv2-groep-kop{display:flex;align-items:center;gap:8px;min-height:44px}
+.amv2-groep-kop h3{margin:0;font-size:18px;font-weight:650;display:flex;align-items:center;gap:8px;flex:1;min-width:0}
+.amv2-teller{display:inline-grid;place-items:center;min-width:24px;height:22px;padding:0 7px;border-radius:999px;background:var(--a-stil-bg);color:var(--a-zw);font-size:12px;font-weight:600}
+.groep-verbonden .amv2-teller{background:var(--a-goed-bg);color:var(--a-goed)}
+.amv2-inklap{display:grid;place-items:center;width:44px;height:44px;border:0;border-radius:50%;background:transparent;color:var(--a-zw);cursor:pointer;margin-left:auto}
+.amv2-inklap:hover{background:var(--a-stil-bg)}
+.amv2-inklap svg{width:20px;height:20px;transition:transform .2s}
+.amv2-inklap[aria-expanded='false'] svg{transform:rotate(-90deg)}
+.amv2-groep-kop .hulp-knop,.amv2-groep-kop [class*='info-tip']{flex:none}
+.amv2-raster{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px}
+.amv2-raster.tegels{grid-template-columns:repeat(auto-fill,minmax(220px,1fr))}
+
+/* Kaart */
+.amv2-kaart{position:relative;display:flex;align-items:center;gap:14px;min-height:96px;padding:18px;border-radius:var(--a-r);background:var(--a-vl);border:1px solid var(--a-lijn);box-shadow:var(--a-schaduw);transition:transform .18s ease,box-shadow .18s ease,border-color .18s;min-width:0}
+.amv2-kaart:hover{transform:translateY(-2px);box-shadow:0 2px 4px rgba(24,36,61,.06),0 14px 32px rgba(24,36,61,.1)}
+.amv2-kaart[data-access-actief]{border-color:var(--a-ac);box-shadow:0 0 0 3px color-mix(in srgb,var(--a-ac) 25%,transparent),var(--a-schaduw)}
+.amv2-kaart-open{position:absolute;inset:0;border:0;background:transparent;border-radius:inherit;cursor:pointer;z-index:0}
+.amv2-kaart-open:focus-visible,.amv2 button:focus-visible,.amv2 a:focus-visible,.amv2-paneel button:focus-visible,.amv2-paneel a:focus-visible{outline:2px solid var(--a-ac);outline-offset:2px}
+.amv2-kaart>*:not(.amv2-kaart-open){position:relative;z-index:1;pointer-events:none}
+.amv2-kaart .amv2-actie{pointer-events:auto}
+.amv2-kaart-tekst{display:flex;flex-direction:column;gap:3px;min-width:0;flex:1}
+.amv2-kaart-titel{font-size:16px;font-weight:650;line-height:1.25;overflow-wrap:anywhere}
+.amv2-kaart-regel{font-size:13px;line-height:1.35;color:var(--a-zw);overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow-wrap:anywhere}
+.amv2-status{display:inline-flex;align-items:center;gap:5px;align-self:flex-start;margin-top:4px;padding:3px 9px;border-radius:999px;font-size:12px;font-weight:550;line-height:1.3;max-width:100%}
+.amv2-status i{width:6px;height:6px;border-radius:50%;background:currentColor;flex:none}
+.amv2-status svg{width:12px;height:12px}
+.amv2-status.toon-goed{background:var(--a-goed-bg);color:var(--a-goed)}
+.amv2-status.toon-info{background:var(--a-info-bg);color:var(--a-info)}
